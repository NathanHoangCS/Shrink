{
    "manifest_version": 3,
    "name": "Shrink",
    "version": "1.0.0",
    "description": "Compress images instantly. Nothing leaves your machine.",
    "action": {
      "default_popup": "popup.html",
      "default_icon": {
        "16": "icons/16.png",
        "48": "icons/48.png",
        "128": "icons/128.png"
      }
    },
    "icons": {
      "16": "icons/16.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    },
    "permissions": ["storage"]
  }